# Скопируй в .env (только для локального запуска).
# На Render значения выставляются через Settings → Environment.

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- RapidAPI для Bayut и других REST источников ---
RAPIDAPI_KEY=
BAYUT_RAPIDAPI_HOST=bayut.p.rapidapi.com

# --- CORS ---
# Список origins через запятую. На проде включает домен Vercel.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Infra (для будущей персистентности и очередей) ---
REDIS_URL=redis://localhost:6379
DATABASE_URL=
